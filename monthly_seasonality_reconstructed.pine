//@version=5
strategy("Bitcoin Monthly Seasonality — Independent Reconstruction",
     overlay=true,
     initial_capital=10000,
     pyramiding=0,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     process_orders_on_close=false)

// Independent reconstruction from publicly described methodology plus
// independently calculated BITSTAMP:BTCUSD data. This is NOT the author's
// paid Pine source.
//
// Reconstructed table:
//   1) Bitcoin monthly CLOSE-to-CLOSE returns, 2012-2024.
//   2) Group calendar years into the four-year Bitcoin cycle.
//   3) Average each calendar month within each cycle phase.
//   4) Long 100% when that phase/month average is positive; cash otherwise.
//
// The close-to-close convention is strongly pinned by public examples:
// post-halving February ~= 41.32%, January ~= 22.87%, bear December ~= -8.53%,
// and consolidation October ~= 23.37%.
//
// IMPORTANT AUDIT NOTE:
// Applying a table calculated from 2012-2024 back to trades beginning in 2011
// is an in-sample/hindsight backtest. It uses future observations to classify
// historical months. Use the historical mode only to reproduce the headline,
// not as evidence of causal historical performance.

startTime = input.time(timestamp("18 Aug 2011 00:00 +0000"), "Backtest start")
endTime   = input.time(timestamp("31 Jan 2025 23:59 +0000"), "Backtest end")
executionMode = input.string("Author-like", "Execution", options=["Author-like", "Tradable month-open"])
showSeasonality = input.bool(true, "Plot cycle-month average")

f_avg_return(_cycle, _month) =>
    float r = na
    if _cycle == 0  // halving: 2012, 2016, 2020, 2024...
        r := switch _month
            1 => 8.0185
            2 => 11.8493
            3 => -3.6699
            4 => 7.3961
            5 => 10.6993
            6 => 10.7536
            7 => 15.3065
            8 => -1.2841
            9 => 6.6678
            10 => 10.9360
            11 => 24.8430
            12 => 20.1831
    else if _cycle == 1  // post-halving: 2013, 2017, 2021, 2025...
        r := switch _month
            1 => 22.8672
            2 => 41.3202
            3 => 68.8470
            4 => 23.3062
            5 => 8.7571
            6 => -9.6293
            7 => 14.6740
            8 => 36.5576
            9 => -5.6776
            10 => 49.9767
            11 => 165.8279
            12 => -4.6567
    else if _cycle == 2  // bear: 2014, 2018, 2022, 2026...
        r := switch _month
            1 => -11.2970
            2 => -5.8200
            3 => -15.0002
            4 => 4.9233
            5 => 1.7736
            6 => -16.6397
            7 => 9.6062
            8 => -13.6183
            9 => -9.1663
            10 => -4.1726
            11 => -13.8970
            12 => -8.5300
    else  // consolidation: 2011, 2015, 2019, 2023...
        r := switch _month
            1 => -0.0301
            2 => 9.3272
            3 => 9.1589
            4 => 9.3362
            5 => 17.4115
            6 => 17.5015
            7 => -0.6726
            8 => -11.7712
            9 => -2.2532
            10 => 23.3731
            11 => 4.2639
            12 => 7.1176
    r

f_cycle(_year) => _year % 4

cycleNow = f_cycle(year)
avgNow = f_avg_return(cycleNow, month)
bullNow = avgNow > 0
inWindow = time >= startTime and time <= endTime
newMonth = ta.change(time("M")) != 0

// "Author-like" reproduction: identify the new month's state on its first
// daily bar. With TradingView's default broker emulator the market order fills
// at the NEXT bar's open. This matches the independent Python reproduction's
// next-open convention and its 27-trade headline most closely.
if executionMode == "Author-like" and newMonth and inWindow
    if bullNow and strategy.position_size <= 0
        strategy.entry("Long", strategy.long)
    else if not bullNow and strategy.position_size > 0
        strategy.close("Long")

// "Tradable month-open": because the table is frozen and known in advance,
// submit on the final daily bar of the prior month so the default emulator can
// fill at the first bar's open. This is a cleaner implementation for a FIXED
// table, but is not the closest match to the historical headline screenshot.
nextDay = time + 24 * 60 * 60 * 1000
isLastCalendarDay = month(nextDay) != month
nextMonth = month(nextDay)
nextYear = year(nextDay)
nextBull = f_avg_return(f_cycle(nextYear), nextMonth) > 0
if executionMode == "Tradable month-open" and isLastCalendarDay and inWindow
    if nextBull and strategy.position_size <= 0
        strategy.entry("Long", strategy.long)
    else if not nextBull and strategy.position_size > 0
        strategy.close("Long")

if time > endTime and strategy.position_size > 0
    strategy.close("Long")

plot(showSeasonality ? avgNow : na,
     title="Cycle-month average return (%)",
     color=avgNow > 0 ? color.lime : color.red,
     linewidth=2,
     style=plot.style_stepline)

bgcolor(showSeasonality ? (bullNow ? color.new(color.green, 92) : color.new(color.red, 94)) : na)
