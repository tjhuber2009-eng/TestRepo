    },
    {
      "line": 117,
      "text": "dailyClose = request.security(syminfo.tickerid, \"1D\", close[1], lookahead=barmerge.lookahead_off)"
    },
    {
      "line": 118,
      "text": "dailyEma50 = request.security(syminfo.tickerid, \"1D\", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)"
    },
    {
      "line": 119,
      "text": "rsi4h      = request.security(syminfo.tickerid, \"240\", ta.rsi(close, 14)[1], lookahead=barmerge.lookahead_off)"
    },
    {
      "line": 127,
      "text": "rsi1h = ta.rsi(close, 21)"
    },
    {
      "line": 128,
      "text": "[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)"
    },
    {
      "line": 129,
      "text": "atr20  = ta.atr(20)"
    },
    {
      "line": 130,
      "text": "atrMa  = ta.sma(atr20, atrMaLength)"
    },
    {
      "line": 132,
      "text": "volSma = ta.sma(volume, volSmaLength)"
    },
    {
      "line": 133,
      "text": "volOk  = volume > volSpikeRatio * volSma"
    },
    {
      "line": 135,
      "text": "// \u2500\u2500\u2500 Engulfing patterns \u2500\u2500\u2500"
    },
    {
      "line": 138,
      "text": "bullEngulfing = close[1] < open[1] and close > open and close >= open[1] and open <= close[1] and bodySize > prevBody * engBodyMult"
    },
    {
      "line": 139,
      "text": "bearEngulfing = close[1] > open[1] and close < open and open >= close[1] and close <= open[1] and bodySize > prevBody * engBodyMult"
    },
    {
      "line": 142,
      "text": "longStack  = rsi1h > rsiLongMin and macdLine > macdSignal and bullEngulfing and highVol and volOk"
    },
    {
      "line": 143,
      "text": "shortStack = rsi1h < rsiShortMax and macdLine < macdSignal and bearEngulfing and highVol and volOk"
    },
    {
      "line": 144,
      "text": "longSignal  = longStack and dailyBull and h4ConfBull"
    },
    {
      "line": 145,
      "text": "shortSignal = shortStack and dailyBear and h4ConfBear"
    },
    {
      "line": 153,
      "text": "var bool partialTaken  = false"
    },
    {
      "line": 155,
      "text": "// V6 SL-Flip state"
    },
    {
      "line": 156,
      "text": "var bool isFlipPos      = false   // current position is a flip"
    },
    {
      "line": 157,
      "text": "var int pendingFlipSide = 0       // 0=none, 1=pending LONG, -1=pending SHORT"
    },
    {
      "line": 158,
      "text": "var int pendingFlipBar  = na"
    },
    {
      "line": 159,
      "text": "var float pendingFlipRef = na     // reference price (the SL that broke)"
    },
    {
      "line": 160,
      "text": "var int flipEntryBar    = na"
    },
    {
      "line": 161,
      "text": "// V2 Pyramid state"
    },
    {
      "line": 162,
      "text": "var bool pyramided      = false"
    },
    {
      "line": 163,
      "text": "var float pyramidEntry  = na"
    },
    {
      "line": 164,
      "text": "var float initSlDist    = na      // SL distance at entry (for R-calc)"
    },
    {
      "line": 166,
      "text": "// \u2500\u2500\u2500 Timeframe advisory \u2014 strategy's backtest was run on 1H \u2500\u2500\u2500"
    },
    {
      "line": 172,
      "text": "wrongTf = timeframe.period != \"60\""
    },
    {
      "line": 174,
      "text": "// \u2500\u2500\u2500 Cooldown checks \u2500\u2500\u2500"
    },
    {
      "line": 175,
      "text": "longCdBlocked  = not na(lastLongSlBar) and (bar_index - lastLongSlBar) < sameDirCdHours"
    },
    {
      "line": 176,
      "text": "shortCdBlocked = not na(lastShortSlBar) and (bar_index - lastShortSlBar) < sameDirCdHours"
    },
    {
      "line": 177,
      "text": "exitCdBlocked  = not na(lastExitBar) and (bar_index - lastExitBar) < genCdHours"
    },
    {
      "line": 178,
      "text": "isHalted       = not na(haltUntilBar) and bar_index < haltUntilBar"
    },
    {
      "line": 180,
      "text": "canGoLong  = longSignal and not longCdBlocked and not exitCdBlocked and not isHalted"
    },
    {
      "line": 181,
      "text": "canGoShort = shortSignal and not shortCdBlocked and not exitCdBlocked and not isHalted"
    },
    {
      "line": 195,
      "text": "drawdownPct   = (currentEquity - peakEquity) / peakEquity"
    },
    {
      "line": 197,
      "text": "if drawdownPct <= -ddHaltPct and strategy.position_size == 0"
    },
    {
      "line": 198,
      "text": "haltUntilBar := bar_index + ddHaltHours"
    },
    {
      "line": 201,
      "text": "// \u2500\u2500\u2500 Position sizing (notional = equity \u00d7 leverage) \u2500\u2500\u2500"
    },
    {
      "line": 202,
      "text": "// qty = (equity \u00d7 leverage) / price  \u2014 deploys leverage\u00d7 notional of capital"
    },
    {
      "line": 203,
      "text": "// This matches Python v6 backtest: pnl = price_move% \u00d7 leverage \u00d7 equity"
    },
    {
      "line": 204,
      "text": "// A 1% price move at 2\u00d7 leverage = 2% equity change."
    },
    {
      "line": 205,
      "text": "slDistLong  = close - stopLong"
    },
    {
      "line": 206,
      "text": "slDistShort = stopShort - close"
    },
    {
      "line": 207,
      "text": "notionalQty = (currentEquity * leverageInput) / close"
    },
    {
      "line": 208,
      "text": "qtyLong  = slDistLong > 0 ? notionalQty : 0"
    },
    {
      "line": 209,
      "text": "qtyShort = slDistShort > 0 ? notionalQty : 0"
    },
    {
      "line": 211,
      "text": "// \u2500\u2500\u2500 V6 SL-FLIP: execute pending flip if wait elapsed (respects DD halt + generic cooldown) \u2500\u2500\u2500"
    },
    {
      "line": 212,
      "text": "flipReady = useSlFlip and pendingFlipSide != 0 and strategy.position_size == 0 and not na(pendingFlipBar) and (bar_index - pendingFlipBar) >= flipWaitHours and not isHalted and not exitCdBlocked"
    },
    {
      "line": 214,
      "text": "if flipReady"
    },
    {
      "line": 215,
      "text": "lbStart = math.max(0, bar_index - flipSrLookback)"
    },
    {
      "line": 216,
      "text": "if pendingFlipSide == -1"
    },
    {
      "line": 217,
      "text": "swingHigh = ta.highest(high, flipSrLookback)"
    },
    {
      "line": 219,
      "text": "capSl     = pendingFlipRef * (1 + flipSlCapPct)"
    },
    {
      "line": 220,
      "text": "flipSL    = math.min(swingSl, capSl)"
    },
    {
      "line": 221,
      "text": "flipDist  = flipSL - close"
    },
    {
      "line": 222,
      "text": "flipQty   = flipDist > 0 ? (currentEquity * leverageInput) / close : 0"
    },
    {
      "line": 223,
      "text": "if flipQty > 0"
    },
    {
      "line": 224,
      "text": "strategy.entry(\"fS\", strategy.short, qty=flipQty)"
    },
    {
      "line": 225,
      "text": "strategy.exit(\"x\", from_entry=\"fS\", stop=flipSL)"
    },
    {
      "line": 226,
      "text": "isFlipPos   := true"
    },
    {
      "line": 227,
      "text": "flipEntryBar := bar_index"
    },
    {
      "line": 228,
      "text": "storedSL    := flipSL"
    },
    {
      "line": 229,
      "text": "partialTaken := false"
    },
    {
      "line": 230,
      "text": "else if pendingFlipSide == 1"
    },
    {
      "line": 231,
      "text": "swingLow = ta.lowest(low, flipSrLookback)"
    },
    {
      "line": 233,
      "text": "capSl    = pendingFlipRef * (1 - flipSlCapPct)"
    },
    {
      "line": 234,
      "text": "flipSL   = math.max(swingSl, capSl)"
    },
    {
      "line": 235,
      "text": "flipDist = close - flipSL"
    },
    {
      "line": 236,
      "text": "flipQty  = flipDist > 0 ? (currentEquity * leverageInput) / close : 0"
    },
    {
      "line": 237,
      "text": "if flipQty > 0"
    },
    {
      "line": 238,
      "text": "strategy.entry(\"fL\", strategy.long, qty=flipQty)"
    },
    {
      "line": 239,
      "text": "strategy.exit(\"x\", from_entry=\"fL\", stop=flipSL)"
    },
    {
      "line": 240,
      "text": "isFlipPos   := true"
    },
    {
      "line": 241,
      "text": "flipEntryBar := bar_index"
    },
    {
      "line": 242,
      "text": "storedSL    := flipSL"
    },
    {
      "line": 243,
      "text": "partialTaken := false"
    },
    {
      "line": 244,
      "text": "pendingFlipSide := 0"
    },
    {
      "line": 246,
      "text": "// Time-stop for flip positions"
    },
    {
      "line": 247,
      "text": "if isFlipPos and strategy.position_size != 0 and not na(flipEntryBar) and (bar_index - flipEntryBar) >= flipTimeStopH"
    },
    {
      "line": 248,
      "text": "strategy.close_all()"
    },
    {
      "line": 249,
      "text": "isFlipPos := false"
    },
    {
      "line": 251,
      "text": "// Block normal entries while a flip is pending"
    },
    {
      "line": 252,
      "text": "pendingActive = pendingFlipSide != 0"
    },
    {
      "line": 255,
      "text": "if canGoLong and strategy.position_size == 0 and qtyLong > 0 and not pendingActive"
    },
    {
      "line": 256,
      "text": "strategy.entry(\"L\", strategy.long, qty=qtyLong)"
    },
    {
      "line": 257,
      "text": "strategy.exit(\"x\", from_entry=\"L\", stop=stopLong)"
    },
    {
      "line": 258,
      "text": "partialTaken := false"
    },
    {
      "line": 259,
      "text": "isFlipPos := false"
    },
    {
      "line": 260,
      "text": "pyramided := false"
    },
    {
      "line": 261,
      "text": "initSlDist := close - stopLong"
    },
    {
      "line": 263,
      "text": "if canGoShort and strategy.position_size == 0 and qtyShort > 0 and not pendingActive"
    },
    {
      "line": 264,
      "text": "strategy.entry(\"S\", strategy.short, qty=qtyShort)"
    },
    {
      "line": 265,
      "text": "strategy.exit(\"x\", from_entry=\"S\", stop=stopShort)"
    },
    {
      "line": 266,
      "text": "partialTaken := false"
    },
    {
      "line": 267,
      "text": "isFlipPos := false"
    },
    {
      "line": 268,
      "text": "pyramided := false"
    },
    {
      "line": 269,
      "text": "initSlDist := stopShort - close"
    },
    {
      "line": 271,
      "text": "// \u2500\u2500\u2500 Store entry SL for partial TP \u2500\u2500\u2500"
    },
    {
      "line": 272,
      "text": "if strategy.position_size > 0 and strategy.position_size[1] == 0"
    },
    {
      "line": 274,
      "text": "if strategy.position_size < 0 and strategy.position_size[1] == 0"
    },
    {
      "line": 277,
      "text": "// \u2500\u2500\u2500 V2 PYRAMIDING \u2014 add to winning position at +3R \u2500\u2500\u2500"
    },
    {
      "line": 278,
      "text": "if usePyramid and strategy.position_size != 0 and not pyramided and not isFlipPos and not na(initSlDist) and initSlDist > 0"
    },
    {
      "line": 280,
      "text": "if strategy.position_size > 0"
    },
    {
      "line": 281,
      "text": "currentR = (close - entryPx) / initSlDist"
    },
    {
      "line": 282,
      "text": "if currentR >= pyramidR"
    },
    {
      "line": 283,
      "text": "pyramidQty = (currentEquity * leverageInput * pyramidFrac) / close"
    },
    {
      "line": 284,
      "text": "if pyramidQty > 0"
    },
    {
      "line": 285,
      "text": "strategy.entry(\"pL\", strategy.long, qty=pyramidQty)"
    },
    {
      "line": 287,
      "text": "pyrSL = entryPx + 0.5 * initSlDist"
    },
    {
      "line": 288,
      "text": "strategy.exit(\"x\", from_entry=\"L\", stop=pyrSL)"
    },
    {
      "line": 289,
      "text": "strategy.exit(\"px\", from_entry=\"pL\", stop=pyrSL)"
    },
    {
      "line": 291,
      "text": "pyramided := true"
    },
    {
      "line": 292,
      "text": "pyramidEntry := close"
    },
    {
      "line": 293,
      "text": "else if strategy.position_size < 0"
    },
    {
      "line": 294,
      "text": "currentR = (entryPx - close) / initSlDist"
    },
    {
      "line": 295,
      "text": "if currentR >= pyramidR"
    },
    {
      "line": 296,
      "text": "pyramidQty = (currentEquity * leverageInput * pyramidFrac) / close"
    },
    {
      "line": 297,
      "text": "if pyramidQty > 0"
    },
    {
      "line": 298,
      "text": "strategy.entry(\"pS\", strategy.short, qty=pyramidQty)"
    },
    {
      "line": 299,
      "text": "pyrSL = entryPx - 0.5 * initSlDist"
    },
    {
      "line": 300,
      "text": "strategy.exit(\"x\", from_entry=\"S\", stop=pyrSL)"
    },
    {
      "line": 301,
      "text": "strategy.exit(\"px\", from_entry=\"pS\", stop=pyrSL)"
    },
    {
      "line": 303,
      "text": "pyramided := true"
    },
    {
      "line": 304,
      "text": "pyramidEntry := close"
    },
    {
      "line": 306,
      "text": "// \u2500\u2500\u2500 Partial TP (+ move SL to BE after firing) \u2500\u2500\u2500"
    },
    {
      "line": 307,
      "text": "// Use the correct entry ID based on whether position is a flip or main entry"
    },
    {
      "line": 308,
      "text": "if strategy.position_size > 0 and not partialTaken and not na(storedSL)"
    },
    {
      "line": 309,
      "text": "entryPrice = strategy.position_avg_price"
    },
    {
      "line": 310,
      "text": "slDistance  = entryPrice - storedSL"
    },
    {
      "line": 311,
      "text": "if slDistance > 0"
