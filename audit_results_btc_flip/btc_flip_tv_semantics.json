    {
      "line": 312,
      "text": "currentR = (close - entryPrice) / slDistance"
    },
    {
      "line": 313,
      "text": "if currentR >= partialTpR"
    },
    {
      "line": 314,
      "text": "tpId = isFlipPos ? \"fL\" : \"L\""
    },
    {
      "line": 315,
      "text": "strategy.close(tpId, qty_percent=partialTpFrac)"
    },
    {
      "line": 316,
      "text": "partialTaken := true"
    },
    {
      "line": 318,
      "text": "if partialBeBufPct > 0"
    },
    {
      "line": 319,
      "text": "beSL = entryPrice * (1 + partialBeBufPct)"
    },
    {
      "line": 321,
      "text": "strategy.exit(\"x\", from_entry=tpId, stop=newSL)"
    },
    {
      "line": 324,
      "text": "if strategy.position_size < 0 and not partialTaken and not na(storedSL)"
    },
    {
      "line": 325,
      "text": "entryPrice = strategy.position_avg_price"
    },
    {
      "line": 326,
      "text": "slDistance  = storedSL - entryPrice"
    },
    {
      "line": 327,
      "text": "if slDistance > 0"
    },
    {
      "line": 328,
      "text": "currentR = (entryPrice - close) / slDistance"
    },
    {
      "line": 329,
      "text": "if currentR >= partialTpR"
    },
    {
      "line": 330,
      "text": "tpId = isFlipPos ? \"fS\" : \"S\""
    },
    {
      "line": 331,
      "text": "strategy.close(tpId, qty_percent=partialTpFrac)"
    },
    {
      "line": 332,
      "text": "partialTaken := true"
    },
    {
      "line": 333,
      "text": "if partialBeBufPct > 0"
    },
    {
      "line": 334,
      "text": "beSL = entryPrice * (1 - partialBeBufPct)"
    },
    {
      "line": 336,
      "text": "strategy.exit(\"x\", from_entry=tpId, stop=newSL)"
    },
    {
      "line": 339,
      "text": "// \u2500\u2500\u2500 Opposite signal exit (no flip-open) \u2014 use close_all since full close anyway \u2500\u2500\u2500"
    },
    {
      "line": 340,
      "text": "if strategy.position_size > 0 and shortSignal"
    },
    {
      "line": 341,
      "text": "strategy.close_all()"
    },
    {
      "line": 342,
      "text": "if strategy.position_size < 0 and longSignal"
    },
    {
      "line": 343,
      "text": "strategy.close_all()"
    },
    {
      "line": 345,
      "text": "// \u2500\u2500\u2500 Track exits for cooldown + queue flip on SL \u2500\u2500\u2500"
    },
    {
      "line": 346,
      "text": "if strategy.position_size == 0 and strategy.position_size[1] != 0"
    },
    {
      "line": 347,
      "text": "lastExitBar := bar_index"
    },
    {
      "line": 348,
      "text": "wasFlip = isFlipPos"
    },
    {
      "line": 349,
      "text": "slHitLong  = strategy.position_size[1] > 0 and not na(storedSL) and low <= storedSL"
    },
    {
      "line": 350,
      "text": "slHitShort = strategy.position_size[1] < 0 and not na(storedSL) and high >= storedSL"
    },
    {
      "line": 352,
      "text": "lastLongSlBar := bar_index"
    },
    {
      "line": 353,
      "text": "// Queue SHORT flip ONLY if this wasn't already a flip (prevents flip-on-flip)"
    },
    {
      "line": 354,
      "text": "if useSlFlip and not wasFlip"
    },
    {
      "line": 355,
      "text": "pendingFlipSide := -1"
    },
    {
      "line": 356,
      "text": "pendingFlipBar  := bar_index"
    },
    {
      "line": 357,
      "text": "pendingFlipRef  := storedSL"
    },
    {
      "line": 359,
      "text": "lastShortSlBar := bar_index"
    },
    {
      "line": 360,
      "text": "if useSlFlip and not wasFlip"
    },
    {
