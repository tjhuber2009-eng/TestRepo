      "text": "pendingFlipSide := 1"
    },
    {
      "line": 362,
      "text": "pendingFlipBar  := bar_index"
    },
    {
      "line": 363,
      "text": "pendingFlipRef  := storedSL"
    },
    {
      "line": 364,
      "text": "isFlipPos := false"
    },
    {
      "line": 365,
      "text": "pyramided := false"
    },
    {
