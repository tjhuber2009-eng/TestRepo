SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-production-domain.example
SCOPES=read_products,read_inventory
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Audit controls
AUDIT_PRODUCT_LIMIT=250
AUDIT_CONCURRENCY=4
STOREFRONT_TIMEOUT_MS=10000
WEBHOOK_RECEIPT_TTL_DAYS=30

# Automatic webhook-driven verification
AUTO_AUDIT_ENABLED=true
AUTO_AUDIT_DEBOUNCE_SECONDS=20
AUTO_AUDIT_POLL_MS=10000
AUTO_AUDIT_PRODUCT_LIMIT=250

# Periodic reconciliation for missed webhooks / large catalogs
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MINUTES=360
RECONCILIATION_SCHEDULER_POLL_MS=300000
RECONCILIATION_OVERLAP_MINUTES=5
RECONCILIATION_BULK_POLL_SECONDS=60
RECONCILIATION_MAX_RESULT_MB=256
RECONCILIATION_DOWNLOAD_TIMEOUT_MS=900000
RECONCILIATION_MAX_PRODUCTS=500000

# Shopify App Pricing
SHOPIFY_APP_HANDLE=catalogmirror
BILLING_ENFORCED=false
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=
