# Networking
PORT=3000
# Local default is 127.0.0.1. Containers should set 0.0.0.0.
# HOST=127.0.0.1
# Comma-separated production host allowlist, e.g. transcripts.example.com
# ALLOWED_HOSTS=
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=1
MAX_CONNECTIONS=200

# Public YouTube extraction (no YouTube Data API key is used)
# YTDLP_DISABLE_DISCOVERY=0
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# YTDLP_BIN=/absolute/path/to/yt-dlp
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# YTDLP_NODE_BIN=/absolute/path/to/node  # desktop defaults to its bundled Node runtime
YTDLP_MAX_CONCURRENCY=4
YOUTUBE_PAGE_MAX_MB=32
YOUTUBE_CAPTION_MAX_MB=64

# Optional captionless-video speech-to-text
# TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_AUTH=bearer
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
TRANSCRIPTION_CHUNK_SECONDS=900
TRANSCRIPTION_TIMEOUT_MS=240000
TRANSCRIPTION_PROVIDER_ATTEMPTS=1
TRANSCRIPTION_MAX_RESPONSE_MB=8

# Cost / abuse controls
AI_MAX_VIDEO_MINUTES=360
AI_MAX_DOWNLOADED_AUDIO_MB=1024
AI_MAX_CHUNK_MB=24
AI_MAX_CONCURRENCY=2
AI_RATE_LIMIT_PER_HOUR=12
# AI_ACCESS_TOKEN=use-a-long-random-secret-on-public-deployments
AI_PUBLIC_FALLBACK=false

# Optional durable AI chunk checkpoints. Mount this on persistent storage in Docker/Railway.
# AI_CHECKPOINT_DIR=/data/ai-checkpoints
AI_MAX_CHECKPOINT_MB=128

# Optional OpenAI-compatible channel research synthesis
# RESEARCH_API_URL=https://api.openai.com/v1/chat/completions
# RESEARCH_API_KEY=
# RESEARCH_AUTH=bearer
# RESEARCH_MODEL=
RESEARCH_MAX_TOKENS=1200
RESEARCH_TIMEOUT_MS=120000
RESEARCH_MAX_RESPONSE_MB=4

# Server cache / rate limits
TRANSCRIPT_RATE_LIMIT_PER_HOUR=1200
COMMENTS_RATE_LIMIT_PER_HOUR=120
DISCOVER_RATE_LIMIT_PER_HOUR=30
RESEARCH_RATE_LIMIT_PER_HOUR=60
TRANSCRIPT_CACHE_ITEMS=1000
TRANSCRIPT_CACHE_TTL_MINUTES=360
COMMENTS_CACHE_ITEMS=300
COMMENTS_CACHE_TTL_MINUTES=360
AI_CACHE_ITEMS=300
AI_CACHE_TTL_MINUTES=1440

# Optional OpenAI-compatible embedding provider for semantic/hybrid retrieval.
# Semantic indexing is explicit and never runs during normal transcript capture.
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_AUTH=bearer
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=0
EMBEDDING_MAX_BATCH=32
EMBEDDING_MAX_INPUT_CHARS=8000
EMBEDDING_MAX_DIMENSIONS=8192
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_MAX_RESPONSE_MB=16
EMBEDDING_RATE_LIMIT_PER_HOUR=120
EMBEDDING_CACHE_ITEMS=500
EMBEDDING_CACHE_TTL_MINUTES=10080

# Optional durable server-side channel monitoring.
# Automatic scheduling is OFF by default; manual “Check now” still works locally.
MONITORING_ENABLED=false
MONITOR_POLL_SECONDS=300
MONITOR_CAPTION_CONCURRENCY=2
MONITOR_JOB_CONCURRENCY=1
MONITOR_MAX_VIDEOS=50000
MONITOR_RETRY_NO_CAPTIONS_MINUTES=360
MONITOR_RETRY_NO_CAPTIONS_DAYS=14
MONITOR_RATE_LIMIT_PER_HOUR=240
# Persist this directory on a private volume for restart-safe monitoring.
# Docker defaults to /data/monitoring.
# MONITOR_DATA_DIR=/data/monitoring
# Required for monitor administration on hosted/production deployments.
# MONITOR_ACCESS_TOKEN=use-a-different-long-random-secret

# Optional multimodal visual intelligence for public YouTube videos.
# Uses Gemini's Interactions API and public YouTube URL input, so video bytes do not
# need to be downloaded by this server. Visual analysis is explicit and AI-gated.
VISUAL_PROVIDER=gemini
# VISUAL_GEMINI_API_KEY=
# VISUAL_MODEL=gemini-3.8-flash
# agentic is recommended for long-form video; static can be useful for short clips.
VISUAL_PROCESSING=agentic
VISUAL_MAX_OUTPUT_TOKENS=5000
VISUAL_TIMEOUT_MS=300000
VISUAL_MAX_RESPONSE_MB=8
VISUAL_RATE_LIMIT_PER_HOUR=24
VISUAL_CACHE_ITEMS=300
VISUAL_CACHE_TTL_MINUTES=43200
