generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model AuditRun {
  id               String   @id @default(cuid())
  shop             String
  status           String
  trigger          String   @default("MANUAL")
  productsSeen     Int      @default(0)
  productsAudited  Int      @default(0)
  findings         Int      @default(0)
  critical         Int      @default(0)
  warnings         Int      @default(0)
  expected         Int      @default(0)
  catalogTruncated Boolean  @default(false)
  durationMs       Int?
  errorMessage     String?
  startedAt        DateTime @default(now())
  finishedAt       DateTime?

  incidents Incident[]

  @@index([shop, startedAt])
}

model Incident {
  id              String   @id @default(cuid())
  shop            String
  auditRunId      String
  productId       String?
  productTitle    String?
  handle          String?
  variantId       String?
  variantTitle    String?
  sku             String?
  kind            String
  severity        String
  status          String   @default("OPEN")
  expectedValue   String?
  observedValue   String?
  detail          String?
  fingerprint     String
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  resolvedAt      DateTime?

  auditRun AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([shop, status, severity])
  @@unique([shop, fingerprint])
}

model WebhookReceipt {
  id          String    @id
  shop        String
  topic       String
  attempts    Int       @default(1)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([receivedAt])
  @@index([shop, receivedAt])
}

model ShopAuditState {
  shop             String   @id
  shopGid          String?
  pendingChanges   Int      @default(0)
  lastWebhookTopic String?
  lastWebhookAt     DateTime?
  lastAuditAt       DateTime?
  lastAutoAuditAt   DateTime?
  lastAutoAuditError String?
  updatedAt         DateTime @updatedAt
}

model AuditLease {
  shop      String   @id
  owner     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model AuditTask {
  id           String   @id @default(cuid())
  shop         String
  resourceType String
  resourceId   String
  reason       String
  generation   Int      @default(1)
  attempts     Int      @default(0)
  availableAt  DateTime
  lockedBy     String?
  lockedUntil  DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, resourceType, resourceId])
  @@index([availableAt, lockedUntil])
  @@index([shop, availableAt])
}
